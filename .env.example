# ─────────────────────────────────────────────────────────────────────────────
# INTEGRTR × LPU HACKATHON 2026 — TEAM 06
# Employee Onboarding Flow Environment Variables
# Copy to .env before running: cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── PostgreSQL Database ───────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=onboarding_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onboarding_db?schema=public

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── SAP SuccessFactors ────────────────────────────────────────────────────────
# Set SF_MOCK_MODE=false to use real SuccessFactors API credentials
SF_MOCK_MODE=true
SF_API_URL=https://api.successfactors.com
SF_CLIENT_ID=your-sf-client-id-here
SF_PRIVATE_KEY=your-sf-private-key-here

# ── Slack Webhooks ────────────────────────────────────────────────────────────
# Set SLACK_MOCK_MODE=false and supply real webhook URLs
SLACK_MOCK_MODE=true
SLACK_WEBHOOK_TEAM=https://hooks.slack.com/services/YOUR/TEAM/WEBHOOK
SLACK_WEBHOOK_HR=https://hooks.slack.com/services/YOUR/HR/WEBHOOK

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
# 15 minutes in milliseconds
RATE_LIMIT_WINDOW_MS=900000
